<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--Bootstraps-->
    <link href="css/bootstrap.min.css" rel="stylesheet" />
    <script src="js/bootstrap.bundle.min.js"></script>

    <!--Font Awesome-->
    <link rel="stylesheet" href="fontawesome/css/font-awesome.min.css" />
    <title>Halaman Admin</title>
    <link
      rel="icon"
      type="image/png"
      href="../logo/favicon-32x32.png"
      sizes="32x32"
    />
  </head>

  <body>
    <nav class="navbar navbar-light bg-light mb-4">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">
          <b>Tambah Data</b>
        </a>
      </div>
    </nav>
    <div class="container">
      <form id="dataForm" enctype="multipart/form-data">
        <div class="mb-3 row">
          <label for="Tempat_wisata" class="col-sm-2 col-form-label"
            >Tempat Wisata</label
          >
          <div class="col-sm-10">
            <input
              required
              type="text"
              name="tempat_wisata"
              class="form-control"
              id="Tempat_wisata"
              placeholder="ex: Pulau komodo"
              value="<%= it.data.tempat_wisata %>"
            />
          </div>
        </div>
        <div class="mb-3 row">
          <label for="Isi_konten" class="col-sm-2 col-form-label"
            >Isi Konten</label
          >
          <div class="col-sm-10">
            <textarea
              required
              class="form-control"
              name="isi_konten"
              id="Isi_konten"
              rows="3"
              value="<%= it.data.isi_konten %>"
            ></textarea>
          </div>
        </div>
        <div class="mb-3 row">
          <label for="Gambar" class="col-sm-2 col-form-label">Gambar</label>
          <div class="col-sm-10">
            <input
              class="form-control"
              type="file"
              name="gambar"
              id="Gambar"
              accept="image/*"
              required
            />
          </div>
        </div>
        <div class="mb-3 row">
          <label for="map_url" class="col-sm-2 col-form-label">Alamat</label>
          <div class="col-sm-10">
            <input
              required
              type="text"
              name="map_url"
              class="form-control"
              id="map_url"
              value="<%= it.data.map_url %>"
            />
          </div>
        </div>
        <div class="mb-3 row mt-4">
          <div class="col">
            <button type="button" class="btn btn-primary" id="buttonEdit">
              <i class="fa fa-floppy-o" aria-hidden="true"></i>
              Tambah Data
            </button>
            <a href="/admin/index" type="button" class="btn btn-danger">
              <i class="fa fa-reply" aria-hidden="true"></i>
              Batal
            </a>
          </div>
        </div>
      </form>
    </div>
    <script>
      const buttonEdit = document.getElementById("buttonEdit");
      document.getElementById("Isi_konten").value = `<%= it.data.isi_konten %>`;
      buttonEdit.addEventListener("click", async (e) => {
        try {
          e.preventDefault();
          const id = window.location.href.split("/")[5];
          const getoldData = await fetch(
            `http://localhost:3000/getDestinasi/${id}`
          );
          const data = {
            tempat_wisata: document.getElementById("Tempat_wisata").value,
            isi_konten: document.getElementById("Isi_konten").value,
            Gambar: document.getElementById("Gambar").files[0].name,
            map_url: document.getElementById("map_url").value,
          };
          const response = await fetch(
            `http://localhost:3000/editDestinasi/${id}`,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(data),
            }
          );

          if (response.ok) {
            alert("Data berhasil ditambahkan!");
            window.location.href = "/admin/index";
          } else {
            alert("Gagal menambahkan data!");
          }
        } catch (error) {
          console.error("Error:", error);
          alert("Terjadi kesalahan!");
        }
      });
    </script>
  </body>
</html>
